{
  "manifest_version": 3,
  "name": "ChatGPT 网页增强",
  "version": "0.7.1",
  "description": "为 ChatGPT 网页添加回答目录、用户问题时间轴和推广弹窗自动关闭等增强功能。",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/outline.js",
        "src/navigation.js",
        "src/content.js",
        "src/timeline-model.js",
        "src/timeline.js",
        "src/dismiss-promos.js"
      ],
      "css": [
        "src/styles.css",
        "src/timeline.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
